# Supabase (PostgreSQL Database)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=eyJxxx...

# SendGrid (Recomendado para Email)
SENDGRID_API_KEY=SG.xxx...

# Gmail (Alternativa - se não usar SendGrid)
GMAIL_USER=seu@email.com
GMAIL_APP_PASSWORD=xxxx

# Admin Email (para receber notificações)
ADMIN_EMAIL=contato@nhbadvocacia.com

# Vercel URL (será preenchido automaticamente)
VERCEL_URL=https://seu-domain.vercel.app
